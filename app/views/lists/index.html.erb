<div class="lists-banner">
  <div class="banner-content">
    <h1>Save any kind of movie</h1>
  </div>
</div>

<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Movie Lists</h2>
    <%= link_to "Create a movie list", new_list_path, class: "btn btn-success" %>
  </div>

  <div class="row">
    <% @lists.each do |list| %>
      <div class="col-12 col-md-6 col-lg-4 mb-4">
        <%= link_to list_path(list), class: "text-decoration-none" do %>
          <div class="list-card">
            <%= image_tag(list.image_url.presence || "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba", class: "list-image") %>
            <div class="list-card-title">
              <h3><%= list.name %></h3>
            </div>
          </div>
        <% end %>
        <%= button_to "Delete list", list_path(list),
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this list?" },
          class: "btn btn-outline-danger btn-sm mt-2" %>
      </div>
    <% end %>
  </div>
</div>
