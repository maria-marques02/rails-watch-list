<div class="lists-banner">
  <div class="banner-content">
    <h1><%= @list.name %></h1>
  </div>
</div>

<div class="container mt-5">
  <div class="d-flex align-items-center gap-2 mb-4">
    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-success" %>
    <%= link_to "Back to lists", lists_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="row">
    <% @list.movies.each do |movie| %>
      <div class="col-12 col-md-6 col-lg-4 mb-4">
        <div class="card h-100">
          <%= image_tag movie.poster_url, class: "card-img-top" %>

          <div class="card-body">
            <h5 class="card-title"><%= movie.title %></h5>
            <p class="card-text"><%= movie.overview %></p>
            <p>⭐ <%= movie.rating %></p>

            <% bookmark = @list.bookmarks.find_by(movie: movie) %>
            <p><strong>My comment:</strong> <%= bookmark.comment %></p>

            <%= button_to "Remove from list",
              bookmark_path(bookmark),
              method: :delete,
              class: "btn btn-outline-danger btn-sm mt-2" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @list.movies.empty? %>
    <p>No movies in this list</p>
  <% end %>
</div>
